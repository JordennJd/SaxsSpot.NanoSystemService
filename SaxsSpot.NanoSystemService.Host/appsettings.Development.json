{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "psql": "Host=localhost;Port=54321;Database=saxs;Username=postgres;Password=postgres;SearchPath=saxs"
  },
  "Auth":{
    "UseMock": "true"
  },
  "Grpc":{
    "UseMock": "false",
    "ServerAddress": "http://localhost:50051",
    "UseSsl": "false"
  },
  "minio": {
    "accessKey": "s3user",
    "secretKey": "s3secretkey",
    "endpoint": "localhost:9000",
    "bucketName": "nanosystems"
  },
  "kafka": {
    "brokers": ["localhost:29092"],
    "group": "run-generation-consumer-group",
    "topic": "run-generation-queue"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:3000"
    ],
    "AllowedMethods": ["GET", "POST", "PUT", "DELETE"],
    "AllowedHeaders": ["Content-Type", "Authorization"],
    "AllowCredentials": true
  }
}
